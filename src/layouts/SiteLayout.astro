---
/** Document shell with shared chrome, local fonts/styles, skip link and menu behavior. Props: title?: string; main slot. Copy: common.*. */
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileDrawer from '../components/MobileDrawer.astro';
import { getCopy } from '../utils/content.js';
import '../styles/global.css';
import '../styles/components/home.css';
import '../styles/components/pages.css';
import '../styles/components/navigation.css';
interface Props { title?: string; }
const { title = getCopy('common.siteName') } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">{getCopy('common.skipToContent')}</a>
    <Header />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer />
    <MobileDrawer />
    <script>import '../scripts/site.js'; import '../scripts/motion.js';</script>
  </body>
</html>
