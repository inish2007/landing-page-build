---
/** Document shell with shared chrome, local fonts/styles, skip link and menu behavior. Props: title?: string; main slot. Copy: common.*. */
import Header from '../components/Header.astro';
import SiteTheme from '../components/SiteTheme.astro';
import site from '../config/site';
import {validateSiteUrls} from '../utils/urls';
const urlErrors=validateSiteUrls(site);
if(urlErrors.length)throw new Error('Unsafe configured URLs:\n'+urlErrors.join('\n'));
import Footer from '../components/Footer.astro';
import MobileDrawer from '../components/MobileDrawer.astro';
import { getCopy } from '../utils/content';
import '../styles/global.css';
import '../styles/components/home.css';
import '../styles/components/pages.css';
import '../styles/components/navigation.css';
import '../styles/components/motion.css';
interface Props { title?: string; }
const { title = getCopy('common.siteName') } = Astro.props;
---
<!doctype html>
<html lang="en" data-motion-enabled={String(site.theme.motion.enabled)} data-playful-enabled={String(site.theme.motion.playful.enabled)} data-shine-enabled={String(site.theme.motion.playful.shineEnabled)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <SiteTheme />
    {site.branding.favicon && <link rel="icon" href={site.branding.favicon} />}
  </head>
  <body>
    <a href="#main-content" class="skip-link">{getCopy('common.skipToContent')}</a>
    <Header />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer />
    <MobileDrawer />
    <script>
      import '../scripts/site.js';
      import '../scripts/motion.js';
      import {updateCopyrightYear} from '../scripts/copyright.js';
      updateCopyrightYear();
      window.addEventListener('pageshow',updateCopyrightYear);
    </script>
  </body>
</html>
