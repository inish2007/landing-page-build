---
/**
 * Component: SiteLayout
 * Responsibility: Semantic HTML5 document shell, viewport metadata, skip link, and default title.
 * Accepted Props:
 *   - title?: string (Page title string, defaults to 'Aura Creative Studio')
 * Content Keys: Default title fallback. Detailed content strings centralized in Stage 03.
 */
interface Props {
  title?: string;
}

const { title = 'Aura Creative Studio' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100px;
    left: 1rem;
    background: #000000;
    color: #ffffff;
    padding: 0.5rem 1rem;
    z-index: 9999;
    text-decoration: underline;
    font-size: 0.875rem;
    font-family: sans-serif;
    transition: top 0.15s ease;
  }

  .skip-link:focus {
    top: 1rem;
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }
</style>
