---
/** Static supporting routes from pages.json. Props: page; shared SiteLayout handles chrome and motion. */
import SiteLayout from '../layouts/SiteLayout.astro';
import EditorialPage from '../components/EditorialPage.astro';
import Gallery from '../components/Gallery.astro';
import ContactForm from '../components/ContactForm.astro';
import site from '../config/site';
import type { PageConfiguration } from '../config/types';
interface Props {page:PageConfiguration}
import { getCopy } from '../utils/content';
/** Enumerate configured non-home static pages; returns Astro route parameters/props with no side effects. */
export function getStaticPaths(): {params:{slug:string};props:{page:PageConfiguration}}[] {
  return Object.entries(site.pages as Record<string,PageConfiguration>).filter(([id,page]) => id !== 'home' && page.path).map(([,page]) => ({params:{slug:page.path!.replace(/^\/|\/$/g,'')},props:{page}}));
}
const { page } = Astro.props;
---
<SiteLayout title={getCopy(page.titleKey)}>{page.kind === 'gallery' ? <Gallery page={page} /> : page.kind === 'contact' ? <ContactForm /> : <EditorialPage page={page} />}</SiteLayout>
