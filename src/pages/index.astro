---
/** Scaffold home route. No props; common.siteName and home.hero.eyebrow. Full sections follow in Stage 05. */
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCopy } from '../utils/content.js';
---
<SiteLayout><section class="welcome-container"><h1>{getCopy('common.siteName')}</h1><p>{getCopy('home.hero.eyebrow')}</p></section></SiteLayout>
<style>.welcome-container { min-height: 60vh; display: grid; align-content: center; justify-items: center; gap: var(--space-2); padding: var(--space-5) var(--page-gutter); text-align: center; }</style>
