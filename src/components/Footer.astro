---
/** Footer using temporary reference copy and configured navigation/social labels. No props. */
import site from '../config/site';
import SiteIcon from './SiteIcon.astro';
import { getBrandName, getCopy, getNavigation } from '../utils/content';
const links = getNavigation('footer');
const copyright = getCopy('footer.copyright').split('{year}');
if (copyright.length !== 2) throw new Error('footer.copyright must contain exactly one {year} placeholder.');
const buildYear = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-intro"><a class="footer-brand" data-accent="shine" href={site.links.home} aria-label={getBrandName()}>{site.branding.logo ? <img src={site.branding.logo.src} alt="" width={site.branding.logo.width} height={site.branding.logo.height} /> : <span class="gold-shine">{getBrandName()}</span>}</a><p>{copyright[0]}<span data-copyright-year>{buildYear}</span>{copyright[1]}<br />{getCopy('footer.designCredit')}</p></div>
  <div class="footer-group"><h2>{getCopy('footer.connect')}</h2><nav class="footer-social" aria-label={getCopy('footer.connect')}>{getNavigation('social').map(link => <a href={link.url} aria-label={getCopy(link.labelKey)} title={getCopy(link.labelKey)}>{link.id === 'instagram' || link.id === 'facebook' ? <SiteIcon name={link.id} /> : getCopy(link.labelKey)}</a>)}</nav></div>
  <div class="footer-group"><h2>{getCopy('footer.explore')}</h2><nav aria-label={getCopy('common.footerNavigation')}>{links.slice(3).map(link => <a class="playful-link" href={link.path}>{getCopy(link.labelKey)}</a>)}</nav></div>
  <div class="footer-group"><h2>{getCopy('footer.inquire')}</h2><nav aria-label={getCopy('footer.inquire')}>{links.slice(0,3).map(link => <a class="playful-link" href={link.path}>{getCopy(link.labelKey)}</a>)}</nav></div>
</footer>
