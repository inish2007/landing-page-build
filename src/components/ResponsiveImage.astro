---
interface Props {imageKey?:string;aspectRatio?:string;eager?:boolean;sizes?:string;class?:string}
/** Local image and editable crop. Props: imageKey, aspectRatio='3 / 2', eager=false, sizes='100vw', class. Responsive sources come from images.json. Asset dimensions never dictate presentation ratio. */
import { getImage } from '../utils/content';
const { imageKey, aspectRatio = '3 / 2', eager = false, sizes = '100vw', class: className } = Astro.props;
const image = getImage(imageKey);
---
<div class:list={['image-frame', className]} data-motion="reveal" style={`--image-ratio: ${aspectRatio}; --image-fit: ${image.fit || 'cover'}; --image-position: ${image.position?.desktop || '50% 50%'}; --image-position-mobile: ${image.position?.mobile || image.position?.desktop || '50% 50%'}`}>
  <img src={image.src} srcset={image.sources?.map(source => source.src + ' ' + source.width + 'w').join(', ')} sizes={sizes} alt={image.alt} width={image.width} height={image.height} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" />
</div>
