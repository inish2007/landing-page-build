---
interface Props {id:string;textNamespace?:string;imageKey?:string}
/** Collaboration banner or editorial collage, chosen by textNamespace. Props: id, textNamespace, imageKey?. Centralized text and image keys. */
import { getCopy, getNavigation } from '../utils/content';
import site from '../config/site';
const navigation = site.navigation;
import FormattedText from './FormattedText.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import GoldenOutlineText from './GoldenOutlineText.astro';
const { id, textNamespace, imageKey } = Astro.props;
const collaborationCopy = site.text.home.collaborations;
const copy = site.text.home.features;
const isCollaboration = textNamespace === 'home.collaborations';
const links = getNavigation('header');
const about = links.find(link => link.id === 'about')!;
const press = links.find(link => link.id === 'press')!;
const contact = links.find(link => link.id === 'contact')!;
const archive = getNavigation('footer').find(link => link.id === 'archived')!;
---
{isCollaboration ? <section id={id} class="home-collaborations" aria-labelledby={id + '-title'}>
  <ResponsiveImage imageKey={imageKey} aspectRatio="2 / 1" />
  <div class="collaboration-copy" data-motion="reveal"><h2 class="gold-shine" data-accent="shine" tabindex="0" id={id + '-title'}>{collaborationCopy.heading}</h2><div class="collaboration-links">{navigation.collaborations.map(link => <a class="pill-link" data-accent="jelly" data-text-jelly href={link.path}><span class="jelly-surface" aria-hidden="true"></span><span class="jelly-text">{getCopy(link.labelKey)}</span></a>)}</div></div>
</section> : <section id={id} class="home-collage section-shell" data-motion-group aria-label={copy.heading}>
  <a class="collage-about playful-card" data-accent="outline" data-text-jelly data-motion="reveal" href={about.path}><ResponsiveImage sizes="(max-width: 47.999rem) 100vw, 66vw" imageKey="aboutPreview" aspectRatio="4 / 3" /><h2><GoldenOutlineText text={copy.aboutLabel} arrow jelly /></h2></a>
  <a class="collage-press playful-card" data-accent="outline" data-text-jelly data-motion="reveal" href={press.path}><ResponsiveImage sizes="30vw" imageKey="pressPreview" aspectRatio="2 / 3" /><h2><GoldenOutlineText text={copy.pressLabel} arrow jelly /></h2></a>
  <blockquote class="collage-quote" data-motion="reveal"><p><FormattedText segments={copy.quoteSegments} /></p></blockquote>
  <a class="collage-archive playful-card" data-accent="outline" data-text-jelly data-motion="reveal" href={archive.path}><ResponsiveImage sizes="30vw" imageKey="archivePreview" aspectRatio="2 / 3" /><h2><GoldenOutlineText text={copy.archivedLabel} arrow jelly /></h2></a>
  <ResponsiveImage sizes="40vw" imageKey="artworkDetail" aspectRatio="1 / 1" class="collage-artwork" />
  <a class="collage-contact playful-card" data-accent="outline" data-text-jelly data-motion="reveal" href={contact.path}><ResponsiveImage sizes="(max-width: 47.999rem) 85vw, 50vw" imageKey="contactPreview" aspectRatio="3 / 2" /><h2><GoldenOutlineText text={copy.contactLabel} arrow jelly /></h2></a>
</section>}
