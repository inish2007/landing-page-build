---
/** Shared accessible text with a decorative gold-edge sweep. */
import SiteIcon from './SiteIcon.astro';
interface Props { text:string; arrow?:boolean; about?:boolean; jelly?:boolean }
const {text,arrow=false,about=false,jelly=false}=Astro.props;
---
<span class:list={['outlined-label',about && 'outlined-label-about', jelly && 'jelly-text']}><span class="outline-base">{text}{arrow && <span aria-hidden="true"> <SiteIcon name="next" /></span>}</span><span class="outline-sweep" aria-hidden="true">{text}{arrow && <span> <SiteIcon name="next" /></span>}</span></span>
