---
/** Local-only inquiry preview. No props. Labels/messages from contact.*; no network or storage. */
import { getCopy } from '../utils/content';
---
<section class="contact-page page-shell">
  <header class="page-heading"><h1>{getCopy('contact.title')}</h1></header>
  <p class="contact-intro">{getCopy('contact.body')}</p><a class="text-link" href={'mailto:' + getCopy('contact.email')}>{getCopy('contact.emailLabel')}</a>
  <form method="dialog" class="contact-form" data-motion="reveal" data-contact-form>
    <p>{getCopy('contact.localNotice')}</p>
    <label for="inquiry-name">{getCopy('contact.nameLabel')}</label><input id="inquiry-name" name="name" autocomplete="name" required maxlength="150" />
    <label for="inquiry-email">{getCopy('contact.emailField')}</label><input id="inquiry-email" name="email" type="email" autocomplete="email" required maxlength="254" />
    <label for="inquiry-message">{getCopy('contact.messageLabel')}</label><textarea id="inquiry-message" name="message" rows="6" required maxlength="5000"></textarea>
    <button type="submit" hidden data-contact-submit>{getCopy('contact.submit')}</button>
    <p data-contact-status role="status" data-valid-message={getCopy('contact.success')}></p>
  </form>
</section>
<script>import '../scripts/contact.js';</script>
