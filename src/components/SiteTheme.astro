---
/** Emits the configured CSS variables/font faces once per shared layout; no props. */
import site from '../config/site';
import { createThemeCss, getFontPreloads } from '../config/theme';
---
{getFontPreloads(site).map(font => <link rel="preload" href={font.href} as="font" type={font.type} crossorigin="anonymous" />)}
<style is:inline set:html={createThemeCss(site)} />
