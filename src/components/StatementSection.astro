---
interface Props {id:string;textNamespace?:string;imageKey?:string}
/** Artist introduction. Props: id, textNamespace, imageKey. Copy from home.statement. */
import site from '../config/site';
import { getCopy, getNavigation } from '../utils/content';
import FormattedText from './FormattedText.astro';
import ResponsiveImage from './ResponsiveImage.astro';
const { id, textNamespace = 'home.statement', imageKey } = Astro.props;
const copy = getCopy<typeof site.text.home.statement>(textNamespace);
const method = getNavigation('header').find(link => link.id === 'process')!;
---
<section id={id} class="home-intro section-shell" data-motion-group aria-labelledby={id + '-title'}>
  <ResponsiveImage imageKey={imageKey} aspectRatio="3 / 2" sizes="(max-width: 47.999rem) 100vw, 55vw" />
  <div class="intro-copy" data-motion="reveal"><h2 id={id + '-title'}><FormattedText segments={copy.statementSegments} /></h2><a class="small-link playful-link" href={method.path}>{copy.buttonLabel}</a></div>
</section>
