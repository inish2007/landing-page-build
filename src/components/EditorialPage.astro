---
import type { PageConfiguration, EditorialCopy } from '../config/types';
import GoldenOutlineText from './GoldenOutlineText.astro';
interface Props {page:PageConfiguration}
/** Supporting editorial page. Props: page configuration; copy blocks from centralized textNamespace. */
import { getCopy } from '../utils/content';
import ResponsiveImage from './ResponsiveImage.astro';
import AnimatedMedia from './AnimatedMedia.astro';
import SiteIcon from './SiteIcon.astro';
const { page } = Astro.props;
const copy = getCopy<EditorialCopy>(page.textNamespace!);
const goldTitle = page.textNamespace?.startsWith('editorial.') && page.textNamespace !== 'editorial.home-1';
const proseGroups = copy.blocks.reduce<{marked:boolean;blocks:typeof copy.blocks}[]>((groups,block)=>{const marked=block.tag==='P'&&block.highlight==='press-marker';const last=groups.at(-1);if(last?.marked===marked)last.blocks.push(block);else groups.push({marked,blocks:[block]});return groups;},[]);
const imageKeys = page.imageKeys || [];
---
<article class="editorial-page page-shell">
  <header class="page-heading" data-motion="reveal"><h1 data-accent={goldTitle ? "outline" : undefined}>{goldTitle ? <GoldenOutlineText text={copy.title} /> : copy.title}</h1></header>
  <div class="editorial-grid">
    {(page.imageCount || 0) > 0 && <ResponsiveImage imageKey={imageKeys[0] || "homeHero"} aspectRatio="4 / 5" eager />}
    <div class="editorial-prose" data-motion-group>{proseGroups.map(group=>group.marked ? <div class="press-marker-group" data-motion="press-marker">{group.blocks.map(block=><div class="editorial-block"><p><span class="press-marker-ink">{block.text}</span></p></div>)}</div> : group.blocks.map(block => <div class="editorial-block" data-motion="reveal">{block.tag.startsWith('H') ? <h2>{block.text}</h2> : <p>{block.text}</p>}</div>))}</div>
  </div>
  {page.mediaKey && <AnimatedMedia mediaKey={page.mediaKey} />}
  {copy.links && copy.links.length > 0 && <nav class="editorial-links" aria-label={copy.title}>{copy.links.map(link => <a class="playful-link" href={link.href}>{link.label}<span aria-hidden="true"> <SiteIcon name="external" /></span></a>)}</nav>}
  <div class="editorial-image-grid">{Array.from({length:Math.max(0,(page.imageCount || 0)-1)}).map((_, index) => <ResponsiveImage imageKey={imageKeys[index + 1] || "homeIntroSide"} aspectRatio="4 / 3" sizes="(max-width: 48rem) 100vw, 50vw" />)}</div>
</article>
