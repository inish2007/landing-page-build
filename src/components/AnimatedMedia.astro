---
/** GIF video-slot replacement. Props: mediaKey. Static poster is default/no-JS/reduced-motion fallback; controls use centralized copy. */
import media from '../content/media.json';
import { getCopy } from '../utils/content.js';
const { mediaKey } = Astro.props;
const item = media[mediaKey];
---
<div class="animated-media" data-animated-media data-animation-src={item.src} data-poster-src={item.poster}>
  <img src={item.poster} width={item.width} height={item.height} alt={getCopy(item.altKey)} />
  <button data-media-toggle data-play-label={getCopy('media.play')} data-pause-label={getCopy('media.pause')} aria-pressed="false" hidden>{getCopy('media.play')}</button>
</div>
<script>import '../scripts/media.js';</script>
