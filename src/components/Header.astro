---
/** Shared brand and responsive navigation. No props; consumes common.*, nav.*, images.siteLogo and navigation.header. */
import { getCopy, getImage, getNavigation } from '../utils/content.js';
import images from '../content/images.json';
const logo = 'siteLogo' in images ? getImage('siteLogo') : null;
const current = Astro.url.pathname;
---
<header class="site-header" id="top">
  <a class="brand" href="/" aria-label={getCopy('common.siteName')}>
    {logo?.src && <img src={logo.src} alt="" width={logo.width} height={logo.height} />}
    <span>{getCopy('common.siteName')}</span>
  </a>
  <nav class="desktop-nav" aria-label={getCopy('common.primaryNavigation')}>
    {getNavigation('header').map(link => <a href={link.path} aria-current={current === link.path ? 'page' : undefined}>{getCopy(link.labelKey)}</a>)}
  </nav>
  <button class="menu-toggle" data-menu-open aria-controls="mobile-drawer" aria-expanded="false" hidden>{getCopy('common.menuOpenLabel')}<span aria-hidden="true"> ☰</span></button>
</header>
